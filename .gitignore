# Build-time fragment material fetched by a fragment's own fetch script, never
# committed: the NVIDIA installer is ~300 MB, and the LICENSE copies are
# extracted from it so they always match the blob that ships alongside them.
/examples/fragments/nvidia-driver-run/hooks/*.run
/examples/fragments/nvidia-driver-run/hooks/LICENSE
/examples/fragments/nvidia-driver-run/tree/usr/share/licenses/nvidia-driver-run/LICENSE
